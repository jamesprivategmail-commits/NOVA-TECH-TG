# Railway auto-provides this when you add the Postgres plugin
DATABASE_URL=postgresql://user:password@host:port/dbname

# Generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-this-to-something-long-and-random

# Railway sets this automatically — no need to set it yourself
PORT=3000

# Comma-separated DARK CHAT admin IDs
ADMIN_NOVA_IDS=+1-999-234-8321

# Used only by the one-time bootstrap script; never commit the password
# NEW_ADMIN_PASSWORD=change-me
